# Local experiments and the LFS helper cache are not project sources.
/work/*
!/work/README.md
/lfs/

# Runtime files, not project sources.
**/node_modules/
**/__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
Desktop.ini
.env
.env.*
!.env.example
!.env.sample
*.log
*.tmp
~$*

# Local Atelier state and private drafts. Preserve these in a full PC backup.
/V4/atelier/data/runtime.json
/V4/atelier/data/active.json
/V4/atelier/data/render.lock
/V4/atelier/data/server.lock
/V4/atelier/data/jobs/
/V4/atelier/data/drafts/
/V4/atelier/data/uploads/
/V4/atelier/data/designer/

# Redundant publication staging; original revision backups remain included.
/V4/revisions/*/staged/
/V4/revisions/*/transaction/

# Optional private exports, outside the game's canonical card database.
/sauvegardes-personnelles/
/paquets-transfert/

# Private author source, sequel notes and intermediate manuscript drafts.
/V4/story-work/

# Machine-local shortcut; recreated by Lancer-Kalistar.cmd on each computer.
/Kalistar.lnk
/V4/deploy/dist/
/V4/deploy/verification/
/V4/site/assets/supabase/

# Media stay on the production PC, backed up outside the checkout.
# Preserve physical paths, approved locks and component manifests.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.psd
*.psb
*.pdf
*.zip
*.7z
*.rar
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.woff
*.woff2
*.ttf
*.otf
*.pyd
*.mp3
*.mp4
*.wav
*.ogg

# Archive de transfert privee, conservee sur le partage reseau.
/Kalistar.zip
